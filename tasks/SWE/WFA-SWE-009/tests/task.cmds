BUILD_CMD='cd /work && SETUPTOOLS_SCM_PRETEND_VERSION=0.13.0.dev0 python setup.py build_ext --inplace -j 16'
IMPORT_CHECK='cd /work && python -c "import statsmodels.api as sm, statsmodels.tsa.api; print(\"import ok\")"'
TEST_CMD='cd /work && python -m pytest -p no:cacheprovider -q -rfE --continue-on-collection-errors  statsmodels/tsa/tests/test_exponential_smoothing.py > /tmp/test.log 2>&1; rc=$?; tail -n 40 /tmp/test.log; echo "--- pytest summary"; grep -E "^(FAILED|ERROR) " /tmp/test.log | head -60; sed "s/\x1b\[[0-9;]*m//g" /tmp/test.log | grep -E "[0-9]+ (passed|failed|errors?)" | tail -1; exit $rc'
