BUILD_CMD='export SETUPTOOLS_SCM_PRETEND_VERSION=4.1.dev0 CFLAGS=-O0; cd /work && pip install --no-build-isolation --no-deps -e . -q'
IMPORT_CHECK='export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1 FAKETIME_DONT_FAKE_MONOTONIC=1 FAKETIME="@2020-05-02 12:00:00" && cd /work && python -c "import astropy, astropy.units, astropy.coordinates, astropy.timeseries; print(\"import ok\", astropy.__version__)"'
TEST_CMD='cd /work && export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1 FAKETIME_DONT_FAKE_MONOTONIC=1 FAKETIME="@2020-05-02 12:00:00" && python -m pytest -p no:cacheprovider -q -rfE --continue-on-collection-errors -o addopts= -p no:doctestplus astropy/coordinates/tests/test_spectral_coordinate.py astropy/coordinates/tests/test_spectral_quantity.py astropy/io/misc/asdf/tags/coordinates/tests/test_spectralcoord.py astropy/wcs/tests/test_utils.py astropy/wcs/wcsapi/tests/test_fitswcs.py astropy/wcs/wcsapi/tests/test_sliced_low_level_wcs.py  > /tmp/test.log 2>&1; rc=$?; tail -n 40 /tmp/test.log; echo "--- pytest summary"; grep -E "^(FAILED|ERROR) " /tmp/test.log | head -60; sed "s/\x1b\[[0-9;]*m//g" /tmp/test.log | grep -E "[0-9]+ (passed|failed|errors?)" | tail -1; exit $rc'
