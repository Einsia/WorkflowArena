BUILD_CMD='cd /work && pip install --no-build-isolation --no-deps -q -Ccompile-args=-j24 . '
IMPORT_CHECK='cd / && python -c "import scipy, scipy.stats, scipy.signal, scipy.interpolate; print(\"import ok\", scipy.__version__)"'
TEST_CMD='cd / && python -m pytest -p no:cacheprovider -q -rfE --continue-on-collection-errors -n 8 --pyargs scipy.signal.tests.test_short_time_fft scipy.signal.tests.test_spectral > /tmp/test.log 2>&1; rc=$?; tail -n 40 /tmp/test.log; echo "--- pytest summary"; grep -E "^(FAILED|ERROR) " /tmp/test.log | head -60; sed "s/\x1b\[[0-9;]*m//g" /tmp/test.log | grep -E "[0-9]+ (passed|failed|errors?)" | tail -1; exit $rc'
