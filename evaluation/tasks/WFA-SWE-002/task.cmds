BUILD_CMD='export SETUPTOOLS_SCM_PRETEND_VERSION=4.3.dev0 ; cd /work && pip install --no-build-isolation --no-deps -e . -q'
IMPORT_CHECK='export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1 FAKETIME_DONT_FAKE_MONOTONIC=1 FAKETIME="@2021-04-14 12:00:00" && cd /work && python -c "import astropy, astropy.units, astropy.coordinates, astropy.timeseries; print(\"import ok\", astropy.__version__)"'
TEST_CMD='cd /work && export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1 FAKETIME_DONT_FAKE_MONOTONIC=1 FAKETIME="@2021-04-14 12:00:00" && python -m pytest -p no:cacheprovider -q -rfE --continue-on-collection-errors  astropy/utils/masked/tests/test_containers.py astropy/utils/masked/tests/test_function_helpers.py astropy/utils/masked/tests/test_functions.py astropy/utils/masked/tests/test_masked.py astropy/utils/masked/tests/test_table.py  > /tmp/test.log 2>&1; rc=$?; tail -n 40 /tmp/test.log; echo "--- pytest summary"; grep -E "^(FAILED|ERROR) " /tmp/test.log | head -60; sed "s/\x1b\[[0-9;]*m//g" /tmp/test.log | grep -E "[0-9]+ (passed|failed|errors?)" | tail -1; exit $rc'
